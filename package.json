{
  "name": "freelens-eso-extension",
  "version": "2.0.0",
  "description": "Freelens extension for External Secrets Operator",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ganey/freelens-eso-extension.git",
    "directory": "."
  },
  "main": "dist/main.js",
  "renderer": "dist/renderer.js",
  "files": [
    "dist/**/*"
  ],
  "engines": {
    "node": ">= 22.0.0",
    "freelens": "^2.0.0"
  },
  "type": "module",
  "copyright": "© 2025-2026 Freelens Authors",
  "license": "MIT",
  "author": "Freelens community",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "biome": "pnpm dlx @biomejs/biome@2.5.15",
    "biome:check": "pnpm biome check",
    "biome:fix": "pnpm biome check --fix",
    "lint": "pnpm biome:check",
    "knip": "pnpm dlx knip@6.41.0 --dependencies --files --no-gitignore --no-config-hints",
    "knip:check": "pnpm knip:development && pnpm knip:production",
    "knip:development": "pnpm knip",
    "knip:production": "pnpm knip --production --strict",
    "test": "pnpm test:unit",
    "test:unit": "vitest run --pool=threads",
    "type:check": "tsc --noEmit -p tsconfig.json --composite false",
    "build": "pnpm type:check && vite build && vite build --mode main",
    "build:force": "vite build && vite build --mode main",
    "dev:main": "vite build --watch --mode main",
    "dev:renderer": "vite build --watch --no-emptyOutDir",
    "bump-version": "pnpm version --no-commit-hooks --no-git-checks --no-git-tag-version",
    "pack:dev": "pnpm bump-version prerelease && pnpm build && pnpm clean:tgz && pnpm pack && pnpm dlx shx@0.4.0 ls \"$PWD/*.tgz\"",
    "clean": "pnpm dlx shx@0.4.0 rm -rf dist out",
    "clean:dts": "pnpm dlx shx@0.4.0 rm -f \"src/**/*.d.scss.ts\"",
    "clean:node_modules": "pnpm dlx shx@0.4.0 rm -rf node_modules",
    "clean:out": "pnpm dlx shx@0.4.0 rm -rf dist out",
    "clean:tgz": "pnpm dlx shx@0.4.0 rm -f \"*.tgz\"",
    "clean:all": "pnpm \"/^clean:(dts|node_modules|out|tgz)\\$\""
  },
  "devDependencies": {
    "@babel/plugin-proposal-decorators": "^7.29.0",
    "@biomejs/biome": "^1.9.4",
    "@freelensapp/extensions": "^2.0.0",
    "@testing-library/react": "^16.2.0",
    "@types/node": "~22.19.11",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.1.3",
    "electron": "^44.10.0",
    "esbuild": "^0.25.0",
    "jsdom": "^27.0.0",
    "mobx": "^7.0.6",
    "mobx-react": "^10.0.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sass": "^1.97.3",
    "typescript": "5.9.3",
    "vite": "^7.3.1",
    "vitest": "^4.1.9"
  },
  "keywords": [
    "extension",
    "freelensapp",
    "lens",
    "openlens",
    "freelens",
    "external-secrets",
    "eso"
  ],
  "packageManager": "pnpm@11.28.6"
}
